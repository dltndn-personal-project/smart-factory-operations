# 실행 환경 변수 예시 (docs/spec/07-runtime.md 1절). 실제 값이 든 .env는 commit하지 않는다.
# 주석을 풀고 값을 바꿔 쓴다. 적지 않은 변수는 config/default.yaml 기본값을 쓴다.
# HTTP_HOST=0.0.0.0
# HTTP_PORT=8080
# MQTT_URL=mqtt://localhost:1883
# TOPIC_PREFIX=factory
# DATABASE_URL=postgresql://factory:factory@localhost:5432/factory
# IMAGE_ROOT=./data
# LOG_LEVEL=INFO
# FOPS_DEFAULT_CONFIG=config/default.yaml
# FOPS_CONFIG=
# GIT_COMMIT=unknown
# 개발용 compose(compose.yaml) 호스트 포트. 겹치면 바꾼다(07-runtime.md 4절). 모두 127.0.0.1에만 연다.
# FOPS_HTTP_PORT=8080
# FOPS_MQTT_PORT=1883
# FOPS_DB_PORT=5432
